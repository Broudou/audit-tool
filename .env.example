# Copy to server/.env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# MongoDB connection string (local install or Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/audit-tool

# Session cookie secret - generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# CSRF token secret - generate with: openssl rand -base64 48 (must differ from SESSION_SECRET)
CSRF_SECRET=change-me-to-a-different-long-random-string-32-chars

# Origin of the web SPA, used for CORS allow-listing
CLIENT_ORIGIN=http://localhost:5173

# Set to true once served over HTTPS in production
COOKIE_SECURE=false

# Session lifetime
SESSION_TTL_HOURS=8
